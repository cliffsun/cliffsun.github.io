<div class="col mb-4">
  <div class="card h-100 hoverable">
    <div class="row no-gutters">
      {% if project.img %}
        <div class="col-md-6">
          {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 768px) 156px, 50vw" alt="project thumbnail" class="card-img" %}
        </div>
      {% endif %}

      <div class="{% if project.img %}col-md-6{% else %}col-md-12{% endif %}">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <h3 class="card-title mb-0">{{ project.title }}</h3>
            {% if project.github %}
              <div class="github-icon ml-2">
                <a
                  href="{{ project.github }}"
                  target="_blank"
                  rel="noopener"
                  class="btn btn-outline-secondary btn-sm"
                  data-toggle="tooltip"
                  title="Code Repository"
                >
                  <i class="fa-brands fa-github gh-icon"></i>
                </a>
              </div>
            {% endif %}
          </div>

          <p class="card-text mt-2">{{ project.description }}</p>
        </div>
      </div>
    </div>

    {% if project.github_stars %}
      <div class="card-footer small text-muted">
        <i class="fa-solid fa-star"></i>
        {{ project.github_stars }}
      </div>
    {% endif %}
  </div>
</div>
