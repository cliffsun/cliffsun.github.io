<div class="col">
  <div class="card h-100 hoverable">
    {% if project.img %}
      {%
        include figure.liquid
        loading="eager"
        path=project.img
        sizes = "250px"
        alt="project thumbnail"
        class="card-img-top"
      %}
    {% endif %}

    <div class="card-body">
      <div class="d-flex justify-content-between align-items-start">
        <h2 class="card-title mb-0">{{ project.title }}</h2>
        {% if project.github %}
          <div class="github-icon ml-2">
            <a href="{{ project.github }}" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm" data-toggle="tooltip" title="Code Repository">
              <i class="fa-brands fa-github gh-icon"></i>
            </a>
          </div>
        {% endif %}
      </div>

      <p class="card-text mt-2">{{ project.description }}</p>
    </div>

    {% if project.github_stars %}
      <div class="card-footer small text-muted">
        <i class="fa-solid fa-star"></i>
        {{ project.github_stars }}
      </div>
    {% endif %}
  </div>
</div>
